#, python-format
msgid ""
"Formats a date according to the current language, ie "
"<code>format_date(object.create_date)</code>"
msgstr ""
"Formatta una data secondo la lingua corrente, ad es. <code>format_date"
"(object.create_date)</code>"

#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Formats a date and time according to the current language, ie "
"<code>format_datetime(object.create_date)</code>"
msgstr ""
"Formatta data e ora secondo la lingua corrente, ad es. <code>format_datetime"
"(object.create_date)</code>"

#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Formats a number as a time interval, ie <code>format_duration(1.5)</code> "
"returns <code>01:30</code>"
msgstr ""
"Formatta un numero come intervallo di tempo, ad es. <code>format_duration"
"(1.5)</code> restituisce <code>01:30</code>"

#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Formats a time according to the current language, ie "
"<code>format_time(object.create_date)</code>"
msgstr ""
"Formatta un'ora secondo la lingua corrente, ad es. <code>format_time"
"(object.create_date)</code>"

#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Formats an amount according to a currency, usually called like "
"<code>format_amount(object.amount_field, "
"object.currency_id)</code>.<br/>Note you can format any number according to "
"the company currency by using "
"<code>object.env.company.currency_id.format(42)</code>"
msgstr ""
"Formatta un importo secondo una valuta, di solito chiamata come <code>"
"format_amount(object.amount_field, object.currency_id)</code>.<br/>Nota: è "
"possibile formattare qualsiasi numero secondo la valuta dell'azienda usando "
"<code>object.env.company.currency_id.format(42)</code>"

