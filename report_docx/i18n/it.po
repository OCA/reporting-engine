#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Python datetime module. Ie <code>datetime.datetime.now()</code> returns the "
"current date"
msgstr ""
"Modulo Python datetime. Ad es. <code>datetime.datetime.now()</code> "
"restituisce la data corrente"

#. module: report_docx
#. odoo-python
#: code:addons/report_docx/models/ir_actions_report.py:0
#, python-format
msgid ""
"Python relativedelta module. Allows complex date computations like "
"<code>datetime.date.today() + relativedelta(months=2, day=1) - "
"relativedelta(days=1)</code> which returns the date of the last day of the "
"next month"
msgstr ""
"Modulo Python relativedelta. Consente calcoli di date complessi come <code>"
"datetime.date.today() + relativedelta(months=2, day=1) - relativedelta"
"(days=1)</code> che restituisce la data dell'ultimo giorno del mese "
"successivo"

