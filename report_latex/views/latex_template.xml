<odoo>
    <record id="latex_template_view_list" model="ir.ui.view">
        <field name="name">latex.template.list</field>
        <field name="model">latex.template</field>
        <field name="arch" type="xml">
            <list string="LaTeX Templates">
                <field name="name" />
                <field name="is_root" />
                <field name="subtemplate_ids" widget="many2many_tags" />
                <field name="attachment_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="latex_template_view_form" model="ir.ui.view">
        <field name="name">latex.template.form</field>
        <field name="model">latex.template</field>
        <field name="arch" type="xml">
            <form string="LaTeX Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="is_root" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Template Content">
                            <field
                                name="content"
                                widget="ace"
                                options="{'mode': 'latex'}"
                            />
                        </page>
                        <page string="Sub Templates">
                            <field name="subtemplate_ids">
                                <list>
                                    <field name="name" />
                                </list>
                            </field>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids">
                                <list>
                                    <field name="name" />
                                    <field name="mimetype" />
                                    <field name="file_size" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="latex_template_view_search" model="ir.ui.view">
        <field name="name">latex.template.search</field>
        <field name="model">latex.template</field>
        <field name="arch" type="xml">
            <search string="LaTeX Templates">
                <field name="name" />
                <field name="content" />
                <filter
                    string="Root Templates"
                    name="is_root"
                    domain="[('is_root', '=', True)]"
                />
                <filter
                    string="Sub Templates"
                    name="subtemplates"
                    domain="[('is_root', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Root Template"
                        name="group_by_is_root"
                        context="{'group_by': 'is_root'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="latex_template_action" model="ir.actions.act_window">
        <field name="name">LaTeX Templates</field>
        <field name="res_model">latex.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_is_root': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first LaTeX template!
            </p>
            <p>
                LaTeX templates are used to generate PDF reports using LaTeX syntax.
                You can create reusable templates and sub-templates with Jinja2 variables.
            </p>
        </field>
    </record>
</odoo>
