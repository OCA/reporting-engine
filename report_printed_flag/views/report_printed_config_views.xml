<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_report_printed_config_tree" model="ir.ui.view">
        <field name="name">report.printed.config.tree</field>
        <field name="model">report.printed.config</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="active" optional="show" />
                <field name="name" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="model_id" />
                <field name="allowed_model_ids" optional="hide" />
                <field name="model" optional="hide" />
            </tree>
        </field>
    </record>

    <record id="view_report_printed_config_form" model="ir.ui.view">
        <field name="name">report.printed.config.form</field>
        <field name="model">report.printed.config</field>
        <field name="arch" type="xml">
            <form string="Printed Flag Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="active" />
                            <field name="name" />
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="model" invisible="1" />
                            <field name="allowed_model_ids" invisible="1" />
                        </group>
                        <group>
                            <field name="report_printed_log_active" />
                            <field name="report_printed_names_active" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Reports">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field
                                        name="report_id"
                                        domain="[('model', '=', parent.model)]"
                                    />
                                    <field name="domain" widget="domain" />
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Internal notes..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_printed_config_search" model="ir.ui.view">
        <field name="name">report.printed.config.search</field>
        <field name="model">report.printed.config</field>
        <field name="arch" type="xml">
            <search string="Search Printed Flag Configurations">
                <field name="name" />
                <field name="company_id" />
                <field name="model_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="inactive"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_by_model"
                        string="Model"
                        context="{'group_by': 'model_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_printed_config" model="ir.actions.act_window">
        <field name="name">Printed Flag Configurations</field>
        <field name="res_model">report.printed.config</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_report_printed_config_search" />
        <field name="context">{}</field>
    </record>
</odoo>
