<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_report_printed_log_tree" model="ir.ui.view">
        <field name="name">report.printed.log.tree</field>
        <field name="model">report.printed.log</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="name" />
                <field name="create_date" />
                <field name="report_id" />
                <field name="user_id" />
                <field name="company_id" groups="base.group_multi_company" />
            </tree>
        </field>
    </record>

    <record id="view_report_printed_log_search" model="ir.ui.view">
        <field name="name">report.printed.log.search</field>
        <field name="model">report.printed.log</field>
        <field name="arch" type="xml">
            <search string="Search Printed Flag Logs">
                <field name="name" />
                <field name="company_id" />
                <field name="user_id" />
                <field name="res_model" />
                <filter name="create_date" string="Print Date" date="create_date" />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                    <filter
                        name="group_by_model"
                        string="Model"
                        context="{'group_by': 'res_model'}"
                    />
                    <filter
                        name="group_by_name"
                        string="Name"
                        context="{'group_by': 'name'}"
                    />
                    <filter
                        name="group_by_user"
                        string="User"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="group_create_date"
                        string="Print Date"
                        context="{'group_by': 'create_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_report_printed_log" model="ir.actions.act_window">
        <field name="name">Printed Flag Logs</field>
        <field name="res_model">report.printed.log</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_report_printed_log_search" />
        <field name="context">{}</field>
    </record>
</odoo>
