<odoo>
    <!-- Ranges -->
    <record id="view_kpi_threshold_range_tree" model="ir.ui.view">
        <field name="name">kpi.threshold.range.tree</field>
        <field name="model">kpi.threshold.range</field>
        <field name="arch" type="xml">
            <list string="Ranges">
                <field name="name" />
                <field name="min_value" />
                <field name="max_value" />
                <field name="color" widget="color" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>

    <record id="view_kpi_threshold_range_form" model="ir.ui.view">
        <field name="name">kpi.threshold.range.form</field>
        <field name="model">kpi.threshold.range</field>
        <field name="arch" type="xml">
            <form string="Range">
                <header />
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <label for="name" class="oe_edit_only" />
                    <h1>
                        <field name="name" required="True" />
                    </h1>
                    <group>
                        <group id="main-left">
                            <field name="color" widget="color" />
                        </group>
                        <group id="main-right">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                        </group>
                    </group>
                    <notebook>
                        <page string="Definition">
                            <group string="Minimum">
                                <group>
                                    <field name="min_type" />
                                </group>
                                <group>
                                    <field
                                        name="min_fixed_value"
                                        invisible="min_type != 'static'"
                                    />
                                </group>
                                <field
                                    name="min_code"
                                    invisible="min_type not in ('python','local')"
                                />
                            </group>
                            <group string="Maximum">
                                <group>
                                    <field name="max_type" />
                                </group>
                                <group>
                                    <field
                                        name="max_fixed_value"
                                        invisible="max_type != 'static'"
                                    />
                                </group>
                                <field
                                    name="max_code"
                                    invisible="max_type not in ('python','local')"
                                />
                            </group>
                            <field name="error" invisible="not error" />
                        </page>
                        <page string="Thresholds">
                            <field name="threshold_ids" nolabel="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="open_threshold_range_list">
        <field name="name">Ranges</field>
        <field name="res_model">kpi.threshold.range</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_kpi_threshold_range_tree" />
    </record>
</odoo>
