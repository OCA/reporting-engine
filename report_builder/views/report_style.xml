<odoo>
    <record model="ir.ui.view" id="report_style_form_view">
        <field name="model">report.style</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <h2>
                        <field name="name" />
                    </h2>
                    <group>
                        <group string="Number">
                            <field name="rounding_inherit" string="Rounding inherit" />
                            <field name="rounding" invisible="rounding_inherit" />
                            <field name="divider_inherit" string="Factor inherit" />
                            <field name="divider" invisible="divider_inherit" />
                            <field name="prefix_inherit" />
                            <field name="prefix" invisible="prefix_inherit" />
                            <field name="suffix_inherit" />
                            <field name="suffix" invisible="suffix_inherit" />
                        </group>
                        <group string="Color">
                            <field name="text_color_inherit" />
                            <field
                                name="text_color"
                                invisible="text_color_inherit"
                                widget="color"
                            />
                            <field name="background_color_inherit" />
                            <field
                                name="background_color"
                                invisible="background_color_inherit"
                                widget="color"
                            />
                        </group>
                        <group string="Font">
                            <field name="font_style_inherit" />
                            <field name="font_style" invisible="font_style_inherit" />
                            <field name="font_weight_inherit" />
                            <field name="font_weight" invisible="font_weight_inherit" />
                            <field name="font_size_inherit" />
                            <field name="font_size" invisible="font_size_inherit" />
                        </group>
                        <group string="Indent">
                            <field name="indent_level_inherit" />
                            <field
                                name="indent_level"
                                invisible="indent_level_inherit"
                            />
                        </group>
                        <group string="Visibility">
                            <field name="hide_empty_inherit" />
                            <field name="hide_empty" invisible="hide_empty_inherit" />
                            <field name="hide_always_inherit" />
                            <field name="hide_always" invisible="hide_always_inherit" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="report_style_search_view">
        <field name="model">report.style</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="report_style_tree_view">
        <field name="model">report.style</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="report_style_act_window">
        <field name="name">Report Style</field>
        <!-- TODO -->
        <field name="res_model">report.style</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="report_style_menu">
        <field name="name">Report Style</field>
        <field name="parent_id" ref="report_builder_menu" />
        <field name="action" ref="report_style_act_window" />
        <field name="sequence" eval="40" />
    </record>
</odoo>
