<odoo>
    <record model="ir.ui.view" id="report_instance_form_view">
        <field name="model">report.instance</field>
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <field name="id" widget="report_builder" />
                </sheet>
            </form>
        </field>
    </record>
    <record model="ir.ui.view" id="report_instance_form_edit_view">
        <field name="model">report.instance</field>
        <field name="priority" eval="50" />
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="view_report_instance"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            string="View"
                        />
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" />
                        <h1>
                            <field name="name" placeholder="Report Instance Name" />
                        </h1>
                    </div>
                    <group>
                        <field name="template_id" />
                        <field name="base_date" />
                        <field name="active" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Columns">
                            <field name="column_ids" />
                        </page>
                        <page string="Settings">
                            <group>
                                <field name="currency_id" />
                                <field name="show_search_bar" />
                                <field name="show_settings" />
                                <field name="show_pivot_date" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="report_instance_search_view">
        <field name="model">report.instance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="source" />
                <button name="view_report_instance" type="object" string="View" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="report_instance_tree_view">
        <field name="model">report.instance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="report_instance_act_window">
        <field name="name">Report Instance</field>
        <field name="res_model">report.instance</field>
        <field name="path">report_instance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.actions.act_window" id="report_instance_view_act_window">
        <field name="name">Report Instance</field>
        <field name="res_model">report.instance</field>
        <field name="path">report_instance_view</field>
        <field name="view_mode">form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="view_id" ref="report_instance_form_view" />
    </record>

    <record model="ir.ui.menu" id="report_instance_menu">
        <field name="name">Report Instance</field>
        <field name="parent_id" ref="report_builder_menu" />
        <field name="action" ref="report_instance_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
