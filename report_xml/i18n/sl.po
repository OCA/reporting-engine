#. module: report_xml
#: model:ir.model,name:report_xml.model_report_report_xml_abstract
msgid "Abstract XML Report"
msgstr "Abstraktno XML poročilo"

#. module: report_xml
#: model:ir.model.fields,help:report_xml.field_ir_actions_report__xml_declaration
#: model:ir.model.fields,help:report_xml.field_report_pdf_form__xml_declaration
msgid ""
"Add `<?xml encoding=\"...\" version=\"...\"?>` at the start of final report "
"file."
msgstr ""
"Dodaj `<?xml encoding=\"...\" version=\"...\"?>` na začetek končne datoteke "
"poročila."

#. module: report_xml
#: model:ir.actions.report,name:report_xml.demo_xml_report
msgid "Demo xml report"
msgstr "Vzorčno XML poročilo"

#. module: report_xml
#: model:ir.model.fields,help:report_xml.field_ir_actions_report__xml_encoding
#: model:ir.model.fields,help:report_xml.field_report_pdf_form__xml_encoding
msgid ""
"Encoding for XML reports. If nothing is selected, then UTF-8 will be applied."
msgstr "Kodiranje za XML poročila. Če ni izbrano nič, bo uporabljeno UTF-8."

#. module: report_xml
#: model:ir.model.fields,help:report_xml.field_ir_actions_report__xml_extension
#: model:ir.model.fields,help:report_xml.field_report_pdf_form__xml_extension
msgid "Extension for XML Reports, by default is `xml`"
msgstr "Končnica XML poročil; privzeto je `xml`"

#. module: report_xml
#: model:ir.model.fields,help:report_xml.field_ir_actions_report__xsd_schema
#: model:ir.model.fields,help:report_xml.field_report_pdf_form__xsd_schema
msgid ""
"File with XSD Schema for checking content of result report. Can be empty if "
"validation is not required."
msgstr ""
"Datoteka s shemo XSD za preverjanje vsebine končnega poročila. Lahko je "
"prazno, če preverjanje ni potrebno."

#. module: report_xml
#: model:ir.model,name:report_xml.model_ir_actions_report
msgid "Report Action"
msgstr "Dejanje poročila"

#. module: report_xml
#: model:ir.model.fields,field_description:report_xml.field_ir_actions_report__report_type
#: model:ir.model.fields,field_description:report_xml.field_report_pdf_form__report_type
msgid "Report Type"
msgstr "Tip poročila"

#. module: report_xml
#: model:ir.model.fields,help:report_xml.field_ir_actions_report__report_type
#: model:ir.model.fields,help:report_xml.field_report_pdf_form__report_type
msgid ""
"The type of the report that will be rendered, each one having its own "
"rendering method. HTML means the report will be opened directly in your "
"browser PDF means the report will be rendered using Wkhtmltopdf and "
"downloaded by the user."
msgstr ""
"Tip poročila, ki bo izrisano; vsak ima svoj način izrisa. HTML pomeni, da se "
"poročilo odpre neposredno v brskalniku. PDF pomeni, da se poročilo izriše z "
"Wkhtmltopdf in ga uporabnik prenese."

