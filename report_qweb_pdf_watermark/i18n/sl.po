#. module: report_qweb_pdf_watermark
#: model:ir.model.fields,help:report_qweb_pdf_watermark.field_ir_actions_report__pdf_watermark_expression
#: model:ir.model.fields,help:report_qweb_pdf_watermark.field_report_pdf_form__pdf_watermark_expression
msgid ""
"An expression yielding the base64 encoded data to be used as watermark. \n"
"You have access to variables `env` and `docs`"
msgstr ""
"Izraz, ki vrne podatke, kodirane z base64, za uporabo kot vodni žig. \n"
"Na voljo sta spremenljivki `env` in `docs`"

#. module: report_qweb_pdf_watermark
