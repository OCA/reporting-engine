msgstr "Postavitev dokumentov družbe"

#. module: report_qweb_pdf_watermark
#: model_terms:ir.ui.view,arch_db:report_qweb_pdf_watermark.view_base_document_layout
msgid ""
"Note that the watermark is not reflected in the preview to the right.\n"
"                    Use the <b>Preview Document</b> button to see the "
"watermark in the generated PDF."
msgstr ""
"Vodni žig ni prikazan v predogledu na desni.\n"
"                    Za ogled vodnega žiga v ustvarjenem PDF uporabite gumb "
"<b>Predogled dokumenta</b>."

#. module: report_qweb_pdf_watermark
#: model:ir.model,name:report_qweb_pdf_watermark.model_ir_actions_report
